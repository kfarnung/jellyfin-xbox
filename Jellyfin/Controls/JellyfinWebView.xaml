<UserControl
    x:Class="Jellyfin.Controls.JellyfinWebView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Jellyfin.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localize="using:Jellyfin.Helpers.MarkupExtensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Jellyfin.ViewModels"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="800"
    d:DataContext="{d:DesignInstance viewModels:JellyfinWebViewModel}">
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="FadeOut">
            <VisualState>
                <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DeprecationNoticeTransform"
                                                   Storyboard.TargetProperty="Y"
                                                   BeginTime="0:0:20"
                                                   EnableDependentAnimation="True">
                        <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="-5" />
                        <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="-5" />
                        <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="120" />
                    </DoubleAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)"
                                                   Storyboard.TargetName="DeprecationNoticeGrid"
                                                   BeginTime="0:0:21">
                        <DiscreteObjectKeyFrame>
                            <DiscreteObjectKeyFrame.Value>
                                <Visibility>Collapsed</Visibility>
                            </DiscreteObjectKeyFrame.Value>
                        </DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
                <VisualState.StateTriggers>
                    <StateTrigger IsActive="{Binding DisplayDeprecationNotice, Mode=OneWay}" />
                </VisualState.StateTriggers>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <ContentPresenter HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Content="{Binding WebView, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Grid.Row="0"
                  Background="Black"
                  Visibility="{Binding IsNativePlayerVisible, Converter={StaticResource BooleanVisibilityConverter}}">
                <ContentPresenter HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Content="{Binding NativePlayer, UpdateSourceTrigger=PropertyChanged}" />
                <Border
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="24"
                    Padding="20,12"
                    Background="{StaticResource Color90}"
                    CornerRadius="16"
                    IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontM}"
                            Foreground="White"
                            Text="{Binding NativePlaybackProgressText}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontS}"
                            Foreground="White"
                            Text="{localize:Localize Key=NativePlayback.Overlay.Shortcuts.Text}" />
                    </StackPanel>
                </Border>
                <ContentControl
                    x:Name="NativePlaybackInputCapture"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    IsEnabled="{Binding IsNativePlayerVisible}"
                    IsTabStop="True"
                    KeyDown="NativePlaybackInputCapture_KeyDown"
                    UseSystemFocusVisuals="False">
                    <interactivity:Interaction.Behaviors>
                        <behaviors:AutoFocusBehavior FocusOnEnable="True" />
                    </interactivity:Interaction.Behaviors>
                </ContentControl>
            </Grid>

            <!-- WebView2 is created programatically otherwise it won't gain focus -->
            <Grid Grid.Row="0"
                  Background="{StaticResource OverlayColorBG}"
                  Visibility="{Binding IsInProgress, Converter={StaticResource BooleanVisibilityConverter}}">
                <ProgressRing Width="250" Height="250" IsActive="True" Visibility="Visible" />
            </Grid>
        </Grid>

        <Border
            Visibility="{Binding DisplayDeprecationNotice, Converter={StaticResource BooleanVisibilityConverter}}"
            Name="DeprecationNoticeGrid"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            BorderBrush="{StaticResource DangerColor}"
            BorderThickness="1"
            CornerRadius="32"
            Background="{StaticResource Color90}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DeprecationNoticeTransform"/>
            </Border.RenderTransform>
            <TextBlock HorizontalAlignment="Center"
                       Padding="8"
                       HorizontalTextAlignment="Center"
                       Foreground="{StaticResource DangerColor}">
                This version of Jellyfin-for-xbox will soon be deprecated. <LineBreak />
                Please update the Jellyfin Server to 10.11 when it's released. <LineBreak />
                Shortly after the official 10.11 release the next version of this client will not be compatible.
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
